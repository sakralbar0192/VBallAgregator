{
  "name": "vballagregator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/apps/server/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsx -r dotenv/config apps/server/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/apps/server/index.js",
    "prisma:generate": "node -r dotenv/config ./node_modules/.bin/prisma generate --schema packages/core/prisma/schema.prisma && node scripts/ensure-prisma-client-cjs.mjs",
    "prisma:migrate": "node -r dotenv/config ./node_modules/.bin/prisma migrate dev --schema packages/core/prisma/schema.prisma",
    "prisma:deploy": "node -r dotenv/config ./node_modules/.bin/prisma migrate deploy --schema packages/core/prisma/schema.prisma",
    "prisma:studio": "node -r dotenv/config ./node_modules/.bin/prisma studio --schema packages/core/prisma/schema.prisma",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "test": "node -r dotenv/config --experimental-vm-modules ./node_modules/.bin/jest --runInBand --selectProjects unit-integration --coverage && node -r dotenv/config --experimental-vm-modules ./node_modules/.bin/jest --runInBand --selectProjects e2e",
    "test:unit": "node -r dotenv/config --experimental-vm-modules ./node_modules/.bin/jest --runInBand --selectProjects unit-integration --testPathIgnorePatterns=/integration\\.test\\.ts$/",
    "test:integration": "node -r dotenv/config --experimental-vm-modules ./node_modules/.bin/jest --runInBand --selectProjects unit-integration packages/core/src/tests/integration.test.ts",
    "test:e2e": "node -r dotenv/config --experimental-vm-modules ./node_modules/.bin/jest --runInBand --selectProjects e2e",
    "test:ci": "SKIP_INTEGRATION_TESTS=true node -r dotenv/config --experimental-vm-modules ./node_modules/.bin/jest --runInBand --selectProjects unit-integration",
    "test:watch": "node -r dotenv/config --experimental-vm-modules ./node_modules/.bin/jest --runInBand --watch",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@prisma/client": "^6.19.0",
    "@types/node": "^24.9.2",
    "@types/uuid": "^11.0.0",
    "bullmq": "^5.63.0",
    "cross-env": "^10.1.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.1",
    "nodemon": "^3.1.10",
    "prisma": "^6.18.0",
    "redis": "^5.9.0",
    "telegraf": "^4.16.3",
    "telegraf-ratelimit": "^2.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "uuid": "^13.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "eslint": "^10.3.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.5",
    "tsx": "^4.20.6",
    "typescript-eslint": "^8.59.2"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
