# Database Configuration
# Локально с docker-compose (db на порту 5434): используйте имя базы vball_db (как в POSTGRES_DB).
DATABASE_URL="postgresql://user:password@localhost:5434/vball_db"
DB_MAX_CONNECTIONS=10
DB_QUERY_TIMEOUT=30000

# Redis Configuration (обязателен для npm run dev: сессии Telegraf + BullMQ)
# Если порт свободен: docker compose up -d redis  (см. docker-compose.yml, публикация 6379)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# HTTP API (Fastify: /health, /health/ready, /health/live)
API_PORT=3001

# Telegram Bot Configuration (REQUIRED)
# Get your bot token from @BotFather on Telegram
# Format: 1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_BOT_TOKEN=000000000:REPLACE_WITH_YOUR_BOT_TOKEN_FROM_BOTFATHER

# Optional Telegram webhook URL
# TELEGRAM_WEBHOOK_URL=

# Localization
DEFAULT_TIMEZONE=Asia/Irkutsk
DEFAULT_LOCALE=ru-RU

# Notification Settings
NOTIFICATION_RETRIES=3
NOTIFICATION_BATCH_SIZE=50

# Queue Settings
QUEUE_CONCURRENCY=5
QUEUE_KEEP_COMPLETED=100
QUEUE_KEEP_FAILED=50

# Environment
NODE_ENV=development

# Internal read API (S2S). Required for /internal/* routes; notification-worker uses this + INTERNAL_API_BASE_URL.
INTERNAL_API_TOKEN=change-me-in-production

# RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Запись доменных событий в messaging_outbox (в одной транзакции с мутациями для join/leave/markPayment; in-process handlers после коммита).
# OUTBOX_RECORD_ENABLED=true

# OpenTelemetry (optional)
# OTEL_ENABLED=true
# OTEL_SERVICE_NAME=vballagregator
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
