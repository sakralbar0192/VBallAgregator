# ============================================================================
# VBallAgregator Production Environment Configuration
# ============================================================================
# ВАЖНО: Это файл для production окружения
# Все чувствительные данные должны быть заменены на реальные значения
# Никогда не коммитьте этот файл в git!
# ============================================================================

# ============================================================================
# 1. ENVIRONMENT
# ============================================================================
NODE_ENV=production
LOG_LEVEL=info

# ============================================================================
# 2. DATABASE CONFIGURATION
# ============================================================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
# ВАЖНО: Используйте сильный пароль (16+ символов)
DATABASE_URL="postgresql://vball_app:2Th6VpFdMVY08jvJrPFwAZF0@db:5432/vball_prod"

# Database connection pool settings
DB_MAX_CONNECTIONS=20
DB_QUERY_TIMEOUT=30000
DB_IDLE_TIMEOUT=30000

# ============================================================================
# 3. REDIS CONFIGURATION
# ============================================================================
# Redis connection settings
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=Dvpo9QfEWplMStlwXvbQtgSG
REDIS_DB=0
REDIS_TLS=false

# Redis connection pool
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY=100

# ============================================================================
# 4. TELEGRAM BOT CONFIGURATION (REQUIRED)
# ============================================================================
# Get your bot token from @BotFather on Telegram
# Format: 1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
# ВАЖНО: Никогда не делитесь этим токеном!
TELEGRAM_BOT_TOKEN=8291994865:AAE87OpiwRMb5hkVnGZuhjSyEFevzw2hjvY

# Telegram webhook configuration
# Set this to your domain where the bot will receive updates
# TELEGRAM_WEBHOOK_URL - не используется в режиме polling

# Telegram webhook secret token (for signature verification)
# Generate with: openssl rand -base64 32
TELEGRAM_WEBHOOK_SECRET=MW+lzT3luRmIDtj5ANNvc7HCftVf5Z5ptMM09GveEiQ=

# ============================================================================
# 5. API CONFIGURATION
# ============================================================================
# API server settings
API_HOST=0.0.0.0
API_PORT=3000
API_BASE_URL=http://localhost:3000

# CORS settings
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# ============================================================================
# 6. SECURITY CONFIGURATION
# ============================================================================
# JWT Secret for token signing
# Generate with: openssl rand -base64 32
JWT_SECRET=M2y1xO/+YAeuSwnh4JXVDua9z6TcSAJIv3j3TO4wTWA=

# JWT expiration time
JWT_EXPIRES_IN=7d

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================================
# 7. LOCALIZATION
# ============================================================================
DEFAULT_TIMEZONE=Asia/Irkutsk
DEFAULT_LOCALE=ru-RU

# ============================================================================
# 8. NOTIFICATION SETTINGS
# ============================================================================
# Notification retry settings
NOTIFICATION_RETRIES=3
NOTIFICATION_RETRY_DELAY=5000
NOTIFICATION_BATCH_SIZE=50
NOTIFICATION_BATCH_DELAY=1000

# ============================================================================
# 9. QUEUE SETTINGS (BullMQ)
# ============================================================================
# Job queue concurrency
QUEUE_CONCURRENCY=5

# Job retention settings
QUEUE_KEEP_COMPLETED=100
QUEUE_KEEP_FAILED=50
QUEUE_COMPLETED_TTL=3600000
QUEUE_FAILED_TTL=86400000

# ============================================================================
# 10. LOGGING CONFIGURATION
# ============================================================================
# Log output
LOG_FORMAT=json
LOG_OUTPUT=file
LOG_FILE_PATH=/opt/vball-aggregator/logs/app.log
LOG_FILE_MAX_SIZE=10m
LOG_FILE_MAX_FILES=10

# Sensitive data masking in logs
LOG_MASK_SENSITIVE_DATA=true
LOG_MASKED_FIELDS=password,token,secret,key

# ============================================================================
# 11. MONITORING & HEALTH CHECK
# ============================================================================
# Health check settings
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000

# Metrics collection
METRICS_ENABLED=true
METRICS_PORT=9090

# ============================================================================
# 12. BACKUP CONFIGURATION
# ============================================================================
# Database backup settings
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=/opt/vball-aggregator/backups

# ============================================================================
# 13. OPTIONAL: MONITORING & ALERTING
# ============================================================================
# Prometheus settings (if using)
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090

# Grafana settings (if using)
GRAFANA_ENABLED=false
GRAFANA_URL=http://grafana:3000

# ============================================================================
# 14. OPTIONAL: EXTERNAL SERVICES
# ============================================================================
# Email configuration (if needed for notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@your-domain.com

# Slack webhook (if using for alerts)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ============================================================================
# 15. FEATURE FLAGS
# ============================================================================
# Enable/disable features
FEATURE_PAYMENTS_ENABLED=true
FEATURE_NOTIFICATIONS_ENABLED=true
FEATURE_SCHEDULING_ENABLED=true
FEATURE_ANALYTICS_ENABLED=true

# ============================================================================
# NOTES FOR DEPLOYMENT
# ============================================================================
# 1. Замените все CHANGE_ME_* значения на реальные
# 2. Используйте сильные пароли (16+ символов)
# 3. Никогда не коммитьте этот файл в git
# 4. Установите правильные permissions: chmod 600 .env.prod
# 5. Используйте переменные окружения для чувствительных данных
# 6. Регулярно ротируйте секреты
# 7. Используйте vault или secrets manager для production
# 8. Логируйте все изменения конфигурации
# 9. Проверьте все значения перед развертыванием
# 10. Создайте backup перед изменением конфигурации
